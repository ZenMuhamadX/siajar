# Salin file ini menjadi .env lalu isi nilainya.
# .env sudah masuk .gitignore — jangan pernah di-commit.
#
# ATURAN PENTING:
#   - Semua nilai VITE_* IKUT TERPASANG di bundle browser dan bisa dibaca
#     siapa pun. Jadi VITE_* hanya boleh berisi alamat/nama, BUKAN rahasia.
#   - Kode sekolah dan kode admin diverifikasi di server (Supabase Auth).
#     Keduanya TANPA prefiks VITE_, jadi tidak ikut ke bundle.
#   - SUPABASE_SERVICE_ROLE_KEY hanya untuk skrip provisioning. Jangan pernah
#     memberinya prefiks VITE_ dan jangan taruh di kode frontend.

# --- Dipakai aplikasi (masuk bundle, aman dibaca publik) ---
VITE_SUPABASE_URL=https://<supabase-url>
VITE_SUPABASE_ANON_KEY=<anon-public-key>
# Domain email sintetis akun guru. Bukan rahasia.
VITE_AUTH_DOMAIN=siajar.local
# Email akun admin. Bukan rahasia.
VITE_ADMIN_EMAIL=admin@siajar.local

# --- HANYA untuk scripts/provision-auth-accounts.ts (JANGAN pakai VITE_) ---
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SCHOOL_CODE=<kode-sekolah-min-6-karakter>
ADMIN_CODE=<kode-admin-min-6-karakter>
