# Salin file ini menjadi .env lalu isi nilainya.
# .env sudah masuk .gitignore — jangan pernah di-commit.
#
# ATURAN PENTING:
#   - Semua nilai VITE_* IKUT TERPASANG di bundle browser dan bisa dibaca
#     siapa pun. Jadi VITE_* hanya boleh berisi alamat/nama, BUKAN rahasia.
#   - File ini tidak lagi menyimpan rahasia apa pun. Kode guru diatur admin
#     dari panel Data Guru, dan sandi admin dibuat lewat layar setup. Keduanya
#     diverifikasi di server oleh Supabase Auth.
#   - service_role key TIDAK perlu ada di sini. Edge Function `manage-users`
#     menerimanya otomatis dari Supabase.

# --- Dipakai aplikasi (masuk bundle, aman dibaca publik) ---
VITE_SUPABASE_URL=https://<supabase-url>
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Domain email sintetis akun guru. Bukan rahasia.
# HARUS sama dengan secret AUTH_DOMAIN pada Edge Function manage-users,
# karena email akun guru diturunkan dari nilai ini di kedua sisi.
VITE_AUTH_DOMAIN=siajar.local

# Email akun admin. Bukan rahasia.
VITE_ADMIN_EMAIL=admin@siajar.local
