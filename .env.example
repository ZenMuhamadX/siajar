# Salin file ini menjadi .env lalu isi nilainya.
# .env sudah masuk .gitignore — jangan pernah di-commit.
#
# Catatan: semua nilai VITE_* di bawah ikut terpasang di bundle browser.
# Login PIN hanya membatasi tampilan frontend, bukan akses database.
# JANGAN pernah menaruh Supabase service_role key di sini.

VITE_SUPABASE_URL=https://<supabase-url>
VITE_SUPABASE_ANON_KEY=<anon-public-key>
VITE_TEACHER_PIN=<teacher-pin>
VITE_ADMIN_PIN=<admin-pin>
